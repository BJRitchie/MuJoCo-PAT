  <version>0.1.0</version>
  <description>GNC algorithms for MuJoCo-PAT: IController + INavigator with PID and direct navigation</description>
  <maintainer email="ben.ritchie2374@gmail.com">Ben Ritchie</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
