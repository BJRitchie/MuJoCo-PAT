<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pat_telemetry</name>
  <version>0.1.0</version>
  <description>Live telemetry aggregation for MuJoCo-PAT: merges joint state/torque by name and publishes EE setpoint-tracking distance, for PlotJuggler (or any other subscriber) to plot</description>
  <maintainer email="ben.ritchie2374@gmail.com">Ben Ritchie</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
