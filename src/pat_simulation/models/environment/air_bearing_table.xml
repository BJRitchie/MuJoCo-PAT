<mujoco model="air_bearing_table">
  <compiler angle="radian"/>
  <option gravity="0 0 0" timestep="0.002" integrator="RK4">
    <flag gravity="disable"/>
  </option>
  <asset>
    <texture name="table_tex" type="2d" builtin="flat" rgb1="0.22 0.22 0.25" width="128" height="128"/>
    <material name="table_mat" texture="table_tex" reflectance="0.04"/>
    <material name="wall_mat"  rgba="0.35 0.35 0.4 0.7"/>
    <material name="chaser_mat" rgba="0.2 0.5 0.9 1"/>
    <material name="target_mat" rgba="0.9 0.4 0.2 1"/>
  </asset>
  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <body name="table">
      <geom name="surface" type="plane" size="1 1 0.01" material="table_mat"
            friction="0.001 0.001 0.001" contype="1" conaffinity="1"/>
    </body>
    <body name="wall_n" pos=" 0    1.05 0.03"><geom type="box" size="1.05 0.05 0.03" material="wall_mat"/></body>
    <body name="wall_s" pos=" 0   -1.05 0.03"><geom type="box" size="1.05 0.05 0.03" material="wall_mat"/></body>
    <body name="wall_e" pos=" 1.05 0    0.03"><geom type="box" size="0.05 1.05 0.03" material="wall_mat"/></body>
    <body name="wall_w" pos="-1.05 0    0.03"><geom type="box" size="0.05 1.05 0.03" material="wall_mat"/></body>

    <!-- Chaser: 20 cm square, 15 kg, 4 cold-gas thrusters -->
    <body name="chaser" pos="-0.5 0 0.03">
      <joint name="chaser_x"   type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="chaser_y"   type="slide" axis="0 1 0" damping="0.05"/>
      <joint name="chaser_yaw" type="hinge" axis="0 0 1" damping="0.02"/>
      <inertial pos="0 0 0" mass="15" diaginertia="0.05 0.05 0.08"/>
      <geom name="chaser_body" type="box" size="0.10 0.10 0.025"
            material="chaser_mat"
            contype="2" conaffinity="2"/>
      <geom name="thr_fwd_v"  type="cylinder" size="0.008 0.012" pos=" 0.10  0    0" euler="0  1.5708 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_aft_v"  type="cylinder" size="0.008 0.012" pos="-0.10  0    0" euler="0 -1.5708 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_port_v" type="cylinder" size="0.008 0.012" pos=" 0    0.10  0" euler=" 1.5708 0 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_stbd_v" type="cylinder" size="0.008 0.012" pos=" 0   -0.10  0" euler="-1.5708 0 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="dock_port"  type="cylinder" size="0.015 0.005" pos="0.105 0 0"
            euler="0 1.5708 0" rgba="1.0 0.85 0.0 1" contype="0" conaffinity="0" mass="0"/>
      <!-- Actuator sites: index order must match ThrusterCommand.force[4] -->
      <site name="thr_fwd_site"  pos=" 0.10  0    0" size="0.003"/>
      <site name="thr_aft_site"  pos="-0.10  0    0" size="0.003"/>
      <site name="thr_port_site" pos=" 0     0.10 0" size="0.003"/>
      <site name="thr_stbd_site" pos=" 0    -0.10 0" size="0.003"/>
      <site name="chaser_imu"    pos="0 0 0"         size="0.005"/>

      <!-- 3-DOF manipulator arm, rigidly mounted on chaser top face -->
      <body name="arm_link1" pos="0 0 0.03">
        <joint name="arm_joint1" type="hinge" axis="0 0 1"
               range="-3.14159 3.14159" limited="true" damping="0.02" frictionloss="0.01"/>
        <inertial pos="0.05 0 0" mass="0.3" diaginertia="0.0004 0.0004 0.0002"/>
        <geom name="arm_link1_geom" type="capsule" fromto="0 0 0 0.10 0 0"
              size="0.012" rgba="0.7 0.7 0.2 1" contype="0" conaffinity="0"/>

        <body name="arm_link2" pos="0.10 0 0">
          <joint name="arm_joint2" type="hinge" axis="0 1 0"
                 range="-1.5708 1.5708" limited="true" damping="0.02" frictionloss="0.01"/>
          <inertial pos="0.08 0 0" mass="0.25" diaginertia="0.0006 0.0006 0.0001"/>
          <geom name="arm_link2_geom" type="capsule" fromto="0 0 0 0.16 0 0"
                size="0.010" rgba="0.7 0.4 0.2 1" contype="0" conaffinity="0"/>

          <body name="arm_link3" pos="0.16 0 0">
            <joint name="arm_joint3" type="hinge" axis="0 1 0"
                   range="-2.61799 2.61799" limited="true" damping="0.01" frictionloss="0.005"/>
            <inertial pos="0.06 0 0" mass="0.15" diaginertia="0.0002 0.0002 0.00005"/>
            <geom name="arm_link3_geom" type="capsule" fromto="0 0 0 0.12 0 0"
                  size="0.008" rgba="0.7 0.2 0.2 1" contype="0" conaffinity="0"/>
            <site name="arm_ee_site" pos="0.12 0 0" size="0.006"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Target: 24 cm square, 20 kg, stationary -->
    <body name="target" pos="0.4 0 0.03">
      <joint name="target_x"   type="slide" axis="1 0 0" damping="0.01"/>
      <joint name="target_y"   type="slide" axis="0 1 0" damping="0.01"/>
      <joint name="target_yaw" type="hinge" axis="0 0 1" damping="0.005"/>
      <inertial pos="0 0 0" mass="20" diaginertia="0.08 0.08 0.12"/>
      <geom name="target_body" type="box" size="0.12 0.12 0.025"
            material="target_mat"
            contype="2" conaffinity="2"/>
      <geom name="grapple" type="cylinder" size="0.02 0.01" pos="0 0 0.035"
            rgba="0.9 0.9 0.2 1" contype="0" conaffinity="0" mass="0"/>
      <!-- AR tag placeholders for Phase 3 vision -->
      <geom name="tag_a" type="box" size="0.02 0.02 0.001" pos=" 0.08  0.08 0.026" rgba="0 0 0 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="tag_b" type="box" size="0.02 0.02 0.001" pos="-0.08  0.08 0.026" rgba="1 1 1 1" contype="0" conaffinity="0" mass="0"/>
      <site name="target_centre" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>

  <!-- Actuator index order: [fwd=0, aft=1, port=2, stbd=3] — must match ThrusterCommand -->
  <actuator>
    <general name="thr_fwd"  site="thr_fwd_site"  gear="1 0 0 0 0 0"  ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_aft"  site="thr_aft_site"  gear="-1 0 0 0 0 0" ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_port" site="thr_port_site" gear="0 1 0 0 0 0"  ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_stbd" site="thr_stbd_site" gear="0 -1 0 0 0 0" ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>

    <!-- Arm joint torque actuators — index order must match ArmTorqueCommand.effort[3] -->
    <motor name="arm_j1" joint="arm_joint1" gear="1" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="arm_j2" joint="arm_joint2" gear="1" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="arm_j3" joint="arm_joint3" gear="1" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
