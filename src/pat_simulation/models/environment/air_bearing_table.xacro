<?xml version="1.0"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="air_bearing_table">
  <compiler angle="radian"/>
  <option gravity="0 0 0" timestep="0.002" integrator="RK4">
    <flag gravity="disable"/>
  </option>
  <xacro:include filename="$(find pat_platform_description)/xacro/pat_platform_bus.xacro"/>

  <asset>
    <texture name="table_tex" type="2d" builtin="flat" rgb1="0.22 0.22 0.25" width="128" height="128"/>
    <material name="table_mat" texture="table_tex" reflectance="0.04"/>
    <material name="wall_mat"  rgba="0.35 0.35 0.4 0.7"/>
    <material name="target_mat" rgba="0.9 0.4 0.2 1"/>
    <!-- Cosmetic mesh assets from the digital-twin CAD export (visual only,
         mass=0, non-colliding geoms reference these - see
         piper_planar_arm.xacro / pat_platform_bus.xacro for why these can't
         be registered from inside the body-emitting macros themselves). -->
    <xacro:piper_planar_arm_meshes mesh_dir="../manipulators"/>
    <xacro:pat_platform_bus_meshes mesh_dir="../spacecraft/chaser"/>
    <mesh name="cso_target" file="../spacecraft/target/cso.STL"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <body name="table">
      <geom name="surface" type="plane" size="1 1 0.01" material="table_mat"
            friction="0.001 0.001 0.001" contype="1" conaffinity="1"/>
    </body>
    <body name="wall_n" pos=" 0    1.05 0.05"><geom type="box" size="1.05 0.05 0.05" material="wall_mat"/></body>
    <body name="wall_s" pos=" 0   -1.05 0.05"><geom type="box" size="1.05 0.05 0.05" material="wall_mat"/></body>
    <body name="wall_e" pos=" 1.05 0    0.05"><geom type="box" size="0.05 1.05 0.05" material="wall_mat"/></body>
    <body name="wall_w" pos="-1.05 0    0.05"><geom type="box" size="0.05 1.05 0.05" material="wall_mat"/></body>

    <!-- Chaser: the real PAT servicer bus (49.22 kg) floating on the table,
         3-DOF planar (chaser_x/y/yaw), 4 cold-gas thrusters. Bus geometry +
         dual planar Piper arms come from the shared pat_platform_bus macro.
         Origin height (0.2445) is the real bus's own half-height, resting on
         the table - derived from the digital-twin's live TF tree, see
         pat_platform_bus.xacro's bus_box comment for the full derivation. -->
    <body name="chaser" pos="-0.5 0 0.2445">
      <joint name="chaser_x"   type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="chaser_y"   type="slide" axis="0 1 0" damping="0.05"/>
      <joint name="chaser_yaw" type="hinge" axis="0 0 1" damping="0.02"/>

      <!-- arm_contype=2 joins the bus/target's own collision group (bit 2) so
           the arms actually collide with the bus and each other, not MuJoCo's
           implicit default (bit 1, which only the table/walls use) — a bit-1
           arm would not collide with a bit-2 bus. The NMPC's OWN internal
           dynamics model (pat_platform_planar.xacro) intentionally keeps
           arm_contype=0: it's Jacobian/mass-matrix bookkeeping via mj_forward,
           not real contact simulation, and spurious contact forces there
           would fight the QP's own box/torque constraints. -->
      <xacro:pat_platform_bus bus_contype="2" arm_contype="2"
                               bus_visual_mesh="1" arm_visual_mesh="1"/>

      <geom name="dock_port" type="cylinder" size="0.015 0.005" pos="0.305 0 -0.10"
            euler="0 1.5708 0" rgba="1.0 0.85 0.0 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_fwd_v"  type="cylinder" size="0.012 0.016" pos=" 0.30  0    0" euler="0  1.5708 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_aft_v"  type="cylinder" size="0.012 0.016" pos="-0.30  0    0" euler="0 -1.5708 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_port_v" type="cylinder" size="0.012 0.016" pos=" 0    0.25  0" euler=" 1.5708 0 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="thr_stbd_v" type="cylinder" size="0.012 0.016" pos=" 0   -0.25  0" euler="-1.5708 0 0" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" mass="0"/>
      <!-- Actuator sites: index order must match ThrusterCommand.force[4] -->
      <site name="thr_fwd_site"  pos=" 0.30  0    0" size="0.004"/>
      <site name="thr_aft_site"  pos="-0.30  0    0" size="0.004"/>
      <site name="thr_port_site" pos=" 0     0.25 0" size="0.004"/>
      <site name="thr_stbd_site" pos=" 0    -0.25 0" size="0.004"/>
      <site name="chaser_imu"    pos="0 0 0"         size="0.006"/>
    </body>

    <!-- Target (CSO mockup): 20kg, real inertia (predates the digital-twin
         work; kept as-is, see pat_platform_bus.xacro's bus <inertial> for
         why it isn't being replaced by the digital twin's placeholder
         value). Box dimensions below are corrected to the digital twin's
         real CSO_link mesh. -->
    <body name="target" pos="0.4 0 0.1">
      <joint name="target_x"   type="slide" axis="1 0 0" damping="0.01"/>
      <joint name="target_y"   type="slide" axis="0 1 0" damping="0.01"/>
      <joint name="target_yaw" type="hinge" axis="0 0 1" damping="0.005"/>
      <inertial pos="0 0 0" mass="20" diaginertia="0.08 0.08 0.12"/>
      <geom name="target_body" type="box" pos="0 0 0.031" size="0.2025 0.1765 0.131"
            material="target_mat"
            contype="2" conaffinity="2" group="3"/>
      <!-- Placement is the mesh's own local-frame correction only - CSO_link
           hangs off an independent floating joint in the source URDF with no
           static relationship to anything else, so there's no transform to
           derive. Starting guess, needs visual iteration. -->
      <geom name="cso_target_visual" type="mesh" mesh="cso_target"
            quat="0.70711 0.70711 0 0"
            rgba="0.9 0.4 0.2 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="grapple" type="cylinder" size="0.02 0.01" pos="0 0 0.172"
            rgba="0.9 0.9 0.2 1" contype="0" conaffinity="0" mass="0"/>
      <!-- AR tag placeholders for Phase 3 vision -->
      <geom name="tag_a" type="box" size="0.02 0.02 0.001" pos=" 0.08  0.08 0.163" rgba="0 0 0 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="tag_b" type="box" size="0.02 0.02 0.001" pos="-0.08  0.08 0.163" rgba="1 1 1 1" contype="0" conaffinity="0" mass="0"/>
      <site name="target_centre" pos="0 0 0" size="0.005"/>
    </body>

    <!-- Cosmetic markers showing each arm's live task-space setpoint
         (pat_simulation subscribes to /chaser/arm/<side>/ee_setpoint and
         moves these). mocap bodies: kinematically driven via
         data->mocap_pos/mocap_quat (MuJoCoSim::setMocapPose), no
         joint/mass/dynamics, contype=0 so they never collide - purely
         visual. Must be direct children of <worldbody> (a MuJoCo
         requirement for mocap="true"). Parked below the table until the
         first setpoint arrives. -->
    <body name="ee_setpoint_marker_L" mocap="true" pos="0 0 -1">
      <geom type="sphere" size="0.025" rgba="1 0 1 0.6" contype="0" conaffinity="0" mass="0"/>
    </body>
    <body name="ee_setpoint_marker_R" mocap="true" pos="0 0 -1">
      <geom type="sphere" size="0.025" rgba="0 1 1 0.6" contype="0" conaffinity="0" mass="0"/>
    </body>
  </worldbody>

  <!-- Actuator index order: [fwd=0, aft=1, port=2, stbd=3] — must match ThrusterCommand -->
  <actuator>
    <general name="thr_fwd"  site="thr_fwd_site"  gear="1 0 0 0 0 0"  ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_aft"  site="thr_aft_site"  gear="-1 0 0 0 0 0" ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_port" site="thr_port_site" gear="0 1 0 0 0 0"  ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>
    <general name="thr_stbd" site="thr_stbd_site" gear="0 -1 0 0 0 0" ctrlrange="0 5" forcelimited="true" forcerange="0 5"/>

    <!-- Arm joint torque actuators (indices 4..9). Paired by list position with
         pat_simulation's arm_joint_names / arm_actuator_names params. -->
    <motor name="motor2_L" joint="joint2_L" gear="1" ctrlrange="-10 10" ctrllimited="true"/>
    <motor name="motor3_L" joint="joint3_L" gear="1" ctrlrange="-10 10" ctrllimited="true"/>
    <motor name="motor5_L" joint="joint5_L" gear="1" ctrlrange="-5 5"   ctrllimited="true"/>
    <motor name="motor2_R" joint="joint2_R" gear="1" ctrlrange="-10 10" ctrllimited="true"/>
    <motor name="motor3_R" joint="joint3_R" gear="1" ctrlrange="-10 10" ctrllimited="true"/>
    <motor name="motor5_R" joint="joint5_R" gear="1" ctrlrange="-5 5"   ctrllimited="true"/>
  </actuator>
</mujoco>
